# Copy to .env.production on the server (never commit it). Used both by
#   docker compose -f compose.prod.yml --env-file .env.production ...
# and as the environment of the web and worker containers.
# Generate passwords with: openssl rand -hex 24   (hex keeps them URL-safe)

# --- Site ---
DOMAIN=sign.example.com
ACME_EMAIL=ops@example.com
BETTER_AUTH_URL=https://sign.example.com
BETTER_AUTH_SECRET=

# --- Database (roles are created on the first start of the volume) ---
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
MIGRATOR_DB_PASSWORD=

# --- Document storage (S3-compatible: Hetzner Object Storage, Cloudflare R2, AWS S3) ---
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
# S3_PREFIX=stampd/

# --- Email (SMTP; port 465 = TLS, otherwise STARTTLS) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=Stampd
EMAIL_FROM_ADDRESS=no-reply@example.com

# --- Seal certificate (PKCS#12). The file is mounted as a Docker secret (default ./secrets/seal.p12). ---
SEAL_P12_FILE=./secrets/seal.p12
SEAL_P12_PASSWORD=

# --- Backups: a different bucket (ideally another provider) with add-only credentials ---
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_PREFIX=stampd
BACKUP_HOUR_UTC=2
