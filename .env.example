DATABASE_URL=postgres://stampd_app:app@localhost:5433/stampd
MIGRATOR_DATABASE_URL=postgres://stampd_migrator:migrator@localhost:5433/stampd
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3100
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=stampd-dev
S3_ACCESS_KEY=stampd
S3_SECRET_KEY=stampd-s3-secret
# Optional folder inside a shared bucket, e.g. S3_PREFIX=stampd/
# For Cloudflare R2: S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com and S3_REGION=auto

# Email over SMTP, sent by the worker (`npm run worker`). Port 465 = TLS, else STARTTLS.
# Dev: an Ethereal test account, or the Mailpit container (SMTP_HOST=localhost, SMTP_PORT=1025,
# no user/pass; inbox at http://localhost:8025).
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=Stampd
EMAIL_FROM_ADDRESS=
